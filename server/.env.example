PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/tripzova
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
MSG91_WIDGET_ID=your_msg91_widget_id
MSG91_AUTHKEY=your_msg91_server_auth_key

# Optional SMTP for real password-reset emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@tripzova.com

# Admin bootstrap account (used by npm run create-admin)
ADMIN_EMAIL=admin@tripzova.com
ADMIN_PASSWORD=replace_with_a_strong_password_12_chars_or_more
ADMIN_FIRST_NAME=TRIPZOVA
ADMIN_LAST_NAME=Admin

# Only needed when copying an existing Mongo database to a new Mongo database
LEGACY_MONGO_URI=mongodb://127.0.0.1:27017/old_tripzova

# Public support destination used by the contact form's optional SMTP forwarding
SUPPORT_EMAIL=tripzovasupport@gmail.com
